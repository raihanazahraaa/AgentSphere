# AgentSphere backend configuration (Phase 1)
# Copy to backend/.env and fill in.

# MySQL is the target store (Table 3.5). A sqlite URL also works for local UI testing:
#   DATABASE_URL=sqlite:///./agentsphere.db
DATABASE_URL=mysql+pymysql://agentsphere:changeme@localhost:3306/agentsphere

# Change before any deployment. Used to sign session JWTs.
# Must be at least 32 bytes. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=agentsphere-dev-secret-change-me-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:5173

# "local" serves answers from Ollama (Phase 2). "stub" restores the Phase 1 placeholder,
# which is useful for testing the API with no model running.
AGENT_RUNTIME=local

# --- Phase 2: local model serving -----------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_S=90
# Measured on an M3 / 8 GB machine: llama3.2:3b answers a ReAct step in ~2.3s; qwen3:4b
# takes ~10s because it is a thinking model. Fast model leads, stronger one backs it up.
DEFAULT_MODEL=llama3.2:3b
FALLBACK_MODEL=qwen3:4b
REACT_MAX_ITERATIONS=4
MEMORY_BUFFER_TURNS=6
CODE_RUNNER_TIMEOUT_S=5
